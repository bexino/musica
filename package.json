{
  "name": "stage-lyrics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:exe": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-splash.ps1 && node scripts/build-exe.mjs x64 && node scripts/clean-staging.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:offline": "node scripts/verify-offline.mjs",
    "build:exe:ia32": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-splash.ps1 && node scripts/build-exe.mjs ia32 && node scripts/clean-staging.mjs"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "animejs": "^3.2.2",
    "marked": "^12.0.2",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-liquid-glass": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.52.0",
    "vite": "^5.4.21"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "local.stage.lyrics",
    "productName": "Stage Lyrics",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "portable": {
      "splashImage": "build/startup.bmp",
      "unpackDirName": true,
      "useZip": true
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    }
  }
}
